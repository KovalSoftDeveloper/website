---
import StartButton from "./StartButton.astro";
---

<section
  aria-labelledby="closing-title"
  class="px-4 py-24 sm:px-[clamp(1rem,5vw,4.5rem)] lg:py-32"
>
  <h2
    id="closing-title"
    class="max-w-[18ch] text-[clamp(2.25rem,5vw,4rem)] leading-[1.02] font-bold tracking-[-0.03em]"
  >
    Have something in mind? Tell us about it.
  </h2>
  <p class="mt-6 max-w-[48ch] text-xl leading-relaxed text-haze">
    The first conversation is free.
  </p>
  <StartButton class="mt-9" />
</section>
