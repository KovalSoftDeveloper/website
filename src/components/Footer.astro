  <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <a href="/" class="text-2xl font-bold tracking-[-0.02em] text-white">
        KovalSoft
      </a>
      <p class="mt-2">Websites, web apps and software. Based in Ontario.</p>
    </div>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 font-semibold">
        <li>
          <a class="hover:text-white" href="/services">
            Services
          </a>
        </li>
        <li>
          <a class="hover:text-white" href="/work">
            Work
          </a>
        </li>
        <li>
          <a class="hover:text-white" href="/about">
            About
          </a>
        </li>
        <li>
          <a class="hover:text-white" href="/contact">
            Contact
          </a>
        </li>
        <li>
