---
interface Props {
  class?: string;
}
const { class: extra } = Astro.props;
---

<a
  href="/contact"
  class:list={[
    "group inline-flex items-center gap-3 rounded-xl bg-sky px-7 py-4 text-xl font-bold text-ink transition-[filter] duration-200 hover:brightness-110 lg:text-2xl",
    extra,
  ]}
>
  Start a project
  <svg
    class="size-6 transition-transform duration-200 ease-(--ease-out) group-hover:translate-x-1 motion-reduce:transition-none"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M4 12h15M13 6l6 6-6 6"></path>
  </svg>
</a>
