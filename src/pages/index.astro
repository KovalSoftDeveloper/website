---
import Base from "../layouts/Base.astro";
import Stage from "../components/home/Stage.astro";
import StartButton from "../components/StartButton.astro";
import Steps from "../components/Steps.astro";
import ClosingCta from "../components/ClosingCta.astro";
import { kindScreen, services } from "../data/services";
import WorkSlot from "../components/WorkSlot.astro";

const plus = "M5 12h14M12 5v14";
---

<Base
  title="KovalSoft | Websites, web apps and software for your business"
  description="We build websites, web apps, business tools and mobile apps from scratch, in plain words, with one point of contact. Based in Ontario."
>
  <section
    aria-labelledby="hero-title"
    class="grid gap-y-10 overflow-x-clip px-4 pt-10 pb-16 sm:px-[clamp(1rem,5vw,4.5rem)] lg:min-h-[calc(100dvh-6rem)] lg:grid-cols-[minmax(0,35rem)_1fr] lg:gap-x-2 lg:pt-0 lg:pb-10"
  >
    <!-- top pad shrinks on short screens so all four rows fit, one open, at 900px -->
    <div class="lg:pt-[clamp(1rem,16vh_-_7.5rem,5rem)]">
      <h1
        id="hero-title"
        class="text-[clamp(2.375rem,4.1vw,3.625rem)] leading-[1.02] font-bold tracking-[-0.03em]"
      >
        We build the software your business runs on.
      </h1>
      <p class="mt-5 max-w-[27ch] text-xl leading-snug text-haze lg:max-w-[34ch] lg:text-2xl">
        Websites, web apps, business tools and mobile apps. Built from scratch,
        in plain words, with one contact the whole way.
      </p>
      <StartButton class="mt-8" />

      <!-- one readable screen on narrow viewports; rows show the other three -->
      <div class="mt-10 max-w-[30rem] lg:hidden">
        <Stage solo="bookings" />
      </div>

      <div class="mt-10 max-w-[30rem] lg:mt-8" data-services>
        <h2 class="sr-only">What we build</h2>
        {services.map((s) => (
          <details
            name="services"
            data-kind={s.kind}
            class="group border-t-2 border-rule"
          >
            <summary class="flex cursor-pointer list-none items-center gap-4 py-3 lg:py-2.5 [&::-webkit-details-marker]:hidden">
              <span class="text-[1.375rem] font-semibold leading-tight lg:text-2xl">
                {s.name}
              </span>
              <span class="ml-auto shrink-0 text-lg text-quiet">{s.tag}</span>
              <svg
                class="size-6 shrink-0 text-sky transition-transform duration-200 ease-(--ease-out) group-open:rotate-45 motion-reduce:transition-none"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d={plus} />
              </svg>
            </summary>
            <div class="pb-5 text-lg leading-relaxed text-haze lg:leading-normal">
              <p>
                <span class="font-semibold text-white">Good for: </span>
                {s.forWho}
              </p>
              <ul class="mt-3 space-y-1">
                {s.highlights.map((item) => (
                  <li class="flex gap-3">
                    <span
                      class="mt-[0.7em] h-0.5 w-3 shrink-0 bg-sky"
                      aria-hidden="true"
                    />
                    {item}
                  </li>
                ))}
              </ul>
              {s.kind !== "care" && (
                <div class="mt-5 lg:hidden">
                  <Stage solo={kindScreen[s.kind]} />
                </div>
              )}
              <a
                href={`/services#${s.id}`}
                class="mt-4 inline-block font-semibold text-sky underline decoration-2 underline-offset-[6px] hover:text-white"
              >
                More about {s.name.toLowerCase()}
              </a>
            </div>
          </details>
        ))}
      </div>
    </div>

    <div class="hidden lg:block lg:w-[calc(100%+clamp(1rem,5vw,4.5rem)+3.75rem)] lg:pt-4">
      <Stage />
    </div>
  </section>

  <section
    id="how-we-work"
    aria-labelledby="how-title"
    class="scroll-mt-6 px-4 py-24 sm:px-[clamp(1rem,5vw,4.5rem)] lg:py-32"
  >
    <h2
      id="how-title"
      class="max-w-[20ch] text-[clamp(2rem,4vw,3.25rem)] leading-[1.05] font-bold tracking-[-0.03em]"
    >
      How working with us goes
    </h2>
    <p class="mt-5 max-w-[52ch] text-xl leading-relaxed text-haze">
      You deal with one point of contact from the first call to after launch. We
      explain things in plain language and quote a fixed price, so you always
      know what you're getting.
    </p>
    <div class="mt-14">
      <Steps brief />
    </div>
  </section>

  <section
    aria-labelledby="work-title"
    class="bg-char-2 px-4 py-24 sm:px-[clamp(1rem,5vw,4.5rem)] lg:py-32"
  >
    <h2
      id="work-title"
      class="text-[clamp(2rem,4vw,3.25rem)] leading-[1.05] font-bold tracking-[-0.03em]"
    >
      Selected work
    </h2>
    <div class="mt-12">
      <WorkSlot />
    </div>
  </section>

  <ClosingCta />
</Base>

<script>
  // Opening a service row brings its example screen forward.
  const rows = document.querySelectorAll<HTMLDetailsElement>(
    "[data-services] details",
  );
  for (const row of rows) {
    row.addEventListener("toggle", () => {
      const open = [...rows].find((r) => r.open);
      for (const stage of document.querySelectorAll<HTMLElement>(
        "[data-stage]",
      )) {
        stage.dataset.active = open?.dataset.kind ?? "";
      }
    });
  }
</script>
