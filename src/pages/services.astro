---
import Base from "../layouts/Base.astro";
import Stage from "../components/home/Stage.astro";
import StartButton from "../components/StartButton.astro";
import { services } from "../data/services";

const gutter = "px-4 sm:px-[clamp(1rem,5vw,4.5rem)]";
---

<Base
  title="Services | KovalSoft"
  description="Websites, web apps and business tools, mobile and desktop apps, and care and hosting. Who each one is for and what's included."
>
  <section
    aria-labelledby="services-title"
    class:list={[gutter, "pt-14 pb-12 lg:pt-24 lg:pb-16"]}
  >
    <h1
      id="services-title"
      class="max-w-[16ch] text-[clamp(2.5rem,6vw,5rem)] leading-[1] font-bold tracking-[-0.035em]"
    >
      What we build
    </h1>
    <p class="mt-8 max-w-[52ch] text-xl leading-relaxed text-haze lg:text-2xl lg:leading-snug">
      Four services for businesses that want things to run more smoothly. Every
      one is built from scratch and comes with one point of contact.
    </p>
    <nav aria-label="Services on this page" class="mt-10">
      <ul class="flex flex-wrap gap-3">
        {services.map((s) => (
          <li>
            <a
              href={`#${s.id}`}
              class="inline-block rounded-xl border-2 border-rule px-4 py-2 font-semibold text-white hover:border-sky"
            >
              {s.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  {services.map((s, i) => (
    <section
      id={s.id}
      aria-labelledby={`${s.id}-title`}
      class:list={[
        gutter,
        "scroll-mt-6 py-20 lg:py-24",
        { "bg-char-2": i % 2 === 1 },
      ]}
    >
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-x-20">
        <div>
          <h2
            id={`${s.id}-title`}
            class="text-[clamp(2rem,4vw,3.25rem)] leading-[1.05] font-bold tracking-[-0.03em]"
          >
            {s.name}
          </h2>
          <div class="mt-8 grid gap-10 md:grid-cols-2 md:gap-x-12">
            <div>
              <h3 class="text-xl font-bold">Who it's for</h3>
              <p class="mt-3 text-lg leading-relaxed text-haze">{s.forWho}</p>
              {s.examples && (
                <>
                  <h3 class="mt-8 text-xl font-bold">For example</h3>
                  <p class="mt-3 text-lg leading-relaxed text-haze">
                    {s.examples}
                  </p>
                </>
              )}
            </div>
            <div>
              <h3 class="text-xl font-bold">What's included</h3>
              <ul class="mt-3 text-lg leading-relaxed text-haze">
                {s.includes.map((item) => (
                  <li class="flex gap-3 border-t-2 border-rule py-2.5 last:border-b-2">
                    <span
                      class="mt-[0.75em] h-0.5 w-3 shrink-0 bg-sky"
                      aria-hidden="true"
                    />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
        {s.kind !== "care" && (
          <div class="mx-auto w-full max-w-[26rem] self-center">
            <Stage solo={s.kind} />
          </div>
        )}
      </div>
    </section>
  ))}

  <section
    aria-labelledby="price-title"
    class:list={[gutter, "py-24 lg:py-32"]}
  >
    <h2
      id="price-title"
      class="max-w-[18ch] text-[clamp(2.25rem,5vw,4rem)] leading-[1.02] font-bold tracking-[-0.03em]"
    >
      What does it cost?
    </h2>
    <p class="mt-6 max-w-[52ch] text-xl leading-relaxed text-haze">
      Every project is different, so we quote each one. The first conversation
      is free, and you get a written plan and a fixed quote before anything is
      built. Tell us your budget and timeline in the contact form.
    </p>
    <StartButton class="mt-9" />
  </section>
</Base>
