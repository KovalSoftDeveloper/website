# Copy to .env and fill in real values. Never commit .env.
# In production, set the same names in the Cloudflare dashboard (secrets for the server ones).
RESEND_API_KEY=
# Sender for both emails, on a domain verified in Resend, e.g. KovalSoft <hello@kovalsoft.ca>
RESEND_FROM=
# Where new inquiries are delivered
CONTACT_INBOX=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Shown on /contact as the direct email; leave empty to hide it
PUBLIC_CONTACT_EMAIL=
